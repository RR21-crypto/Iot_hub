# Board: Waveshare ESP32-S3-Touch-LCD-4 (ESP32-S3-WROOM-1-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# 8MB octal PSRAM (frame buffers live here)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# LVGL
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_GIF_CACHE_DECODE_DATA=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Files for LVGL: "S:/gallery/x.jpg" -> /gallery/x.jpg (SPIFFS)
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=83
CONFIG_LV_FS_POSIX_PATH=""
CONFIG_LV_FS_POSIX_CACHE_SIZE=4096
CONFIG_LV_USE_TJPGD=y
# Keep decoded images (2MB, lands in PSRAM) so JPGs are not decoded again on every redraw
CONFIG_LV_CACHE_DEF_SIZE=2097152
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=8
CONFIG_LV_FONT_MONTSERRAT_20=y

# OTA: go back to the previous firmware if the new one does not reach the home screen
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# WiFi/TLS buffers in PSRAM, internal RAM is needed by the LCD driver
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Bluetooth Low Energy with the NimBLE host, its memory in PSRAM
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# printf with floats ("%.1f") in LVGL labels: use the C library instead of LVGL's built-in one
CONFIG_LV_USE_CLIB_SPRINTF=y

# Smoother UI: render with both CPU cores; FPS/CPU overlay available (toggle in Settings > Display)
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_PERF_MONITOR_ALIGN_BOTTOM_LEFT=y

# Stop with a clear "stack overflow in task X" message instead of random crashes
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
